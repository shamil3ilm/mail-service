# ─────────────────────────────────────────────────────────────
# mail-service — configuration
# Copy to .env and edit. All values shown are defaults for local.
# ─────────────────────────────────────────────────────────────

# Deployment mode: local | cloud
MAIL_MODE=local

# Log level: debug | info | warn | error
MAIL_LOG_LEVEL=debug
# Log format: json | text (text = human-friendly for dev)
MAIL_LOG_FORMAT=text

# Network binding
# local mode defaults to 127.0.0.1; cloud mode should use 0.0.0.0
MAIL_LISTEN_ADDR=127.0.0.1

# HTTP dashboard + API
MAIL_HTTP_PORT=8035

# Admin port (pprof, metrics) — never expose publicly
MAIL_ADMIN_PORT=8036

# SMTP inbound (dev catch)
MAIL_SMTP_PORT=2525

# Submission (authenticated send) — cloud mode
MAIL_SUBMISSION_PORT=587

# Storage
MAIL_DB_PATH=./data/mail.db
MAIL_RAW_STORE_PATH=./data/raw

# Local convenience: auto-verify these domain suffixes without real DNS
MAIL_AUTO_VERIFY_DOMAINS=.test,.local,.localhost

# Default mailbox mode when creating: capture | relay
MAIL_DEFAULT_MAILBOX_MODE=capture

# Outbound relay provider: none | smtp | ses | resend
MAIL_RELAY_PROVIDER=none

# SMTP relay (when MAIL_RELAY_PROVIDER=smtp)
MAIL_RELAY_SMTP_HOST=
MAIL_RELAY_SMTP_PORT=587
MAIL_RELAY_SMTP_USER=
MAIL_RELAY_SMTP_PASS=

# Graceful shutdown timeout
MAIL_SHUTDOWN_TIMEOUT=15s
